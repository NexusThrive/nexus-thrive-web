---
import '../styles/global.css';
import { SITE_NAME, SITE_URL, SOCIALS, WHATSAPP_NUMBER, whatsappLink } from '../data/site';

interface Props {
	title: string;
	description?: string;
}

const { title, description } = Astro.props;

const DEFAULT_DESCRIPTION =
	'NEXUS es el sistema operativo para tu negocio: clientes, membresías, pagos, caja y control de acceso conectados en una sola plataforma.';
const HOME_TITLE = 'NEXUS THRIVE — Sistema operativo para tu negocio';
const isHome = title === 'Inicio';
const fullTitle = isHome ? HOME_TITLE : `${title} | ${SITE_NAME}`;
const pageDescription = description ?? DEFAULT_DESCRIPTION;

const CANONICAL = new URL(Astro.url.pathname, SITE_URL);
const OG_IMAGE = new URL('/og-image.webp', SITE_URL);
---

<!doctype html>
<html lang="es" data-theme="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{/*
			Tema antes del primer paint (sin parpadeo): la elección guardada o,
			si no hay, la del sistema operativo. `js` habilita los revelados;
			sin JavaScript todo el contenido queda visible.
		*/}
		<script is:inline>
			(function () {
				var d = document.documentElement;
				d.classList.add('js');
				var t = null;
				try { t = localStorage.getItem('nexus-theme'); } catch (e) {}
				if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				d.dataset.theme = t;
			})();
		</script>
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f6f3" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0a0b" />
		<title>{fullTitle}</title>
		<meta name="description" content={pageDescription} />
		<link rel="canonical" href={CANONICAL} />
		{/* Ícono oficial de la app (N paper sobre bloque Ink): app/icon.svg del repositorio nexus-thrive. */}
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />

		<link rel="preload" href="/fonts/Montserrat-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/Inter-latin.woff2" as="font" type="font/woff2" crossorigin />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:locale" content="es_CO" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={CANONICAL} />
		<meta property="og:image" content={OG_IMAGE} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/webp" />
		<meta property="og:image:alt" content="NEXUS THRIVE — Sistema operativo para tu negocio." />

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@nexusthrive" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={OG_IMAGE} />

		<!-- Datos estructurados: solo lo verificable (nombre, sitio, logo, redes y contacto). -->
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'Organization',
			name: SITE_NAME,
			url: SITE_URL,
			logo: new URL('/icon-512.png', SITE_URL).toString(),
			sameAs: SOCIALS.map((s) => s.href),
			contactPoint: {
				'@type': 'ContactPoint',
				telephone: `+${WHATSAPP_NUMBER}`,
				contactType: 'customer service',
				availableLanguage: 'es',
			},
		})} />

		<!-- Medición básica (Plausible): clics en WhatsApp y en el acceso a la app -->
		<script defer data-domain="nexusthrive.com.co" src="https://plausible.io/js/script.js"></script>
		<script is:inline>
			window.plausible = window.plausible || function () { (window.plausible.q = window.plausible.q || []).push(arguments); };
			document.addEventListener('click', function (e) {
				var link = e.target.closest && e.target.closest('a[data-cta]');
				if (!link) return;
				var cta = link.getAttribute('data-cta');
				if (cta.indexOf('whatsapp') === 0) window.plausible('whatsapp_click', { props: { origen: cta } });
				else if (cta.indexOf('app') === 0) window.plausible('app_click', { props: { origen: cta } });
			});
		</script>
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<slot />

		<a
			href={whatsappLink('Hola NEXUS THRIVE, quiero conocer la plataforma.')}
			class="wa-float"
			target="_blank"
			rel="noopener"
			aria-label="Escríbenos por WhatsApp"
			data-cta="whatsapp-flotante"
		>
			<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"></path></svg>
		</a>

		<script>
			// Revelado progresivo: marca `.is-in` cuando el bloque entra en pantalla.
			const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
			if (!('IntersectionObserver' in window)) {
				items.forEach((el) => el.classList.add('is-in'));
			} else {
				const io = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-in');
								io.unobserve(entry.target);
							}
						}
					},
					{ rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
				);
				items.forEach((el) => io.observe(el));
			}
		</script>

		<style is:global>
			/* Botón de WhatsApp con la forma de la marca: bloque Ink, esquinas casi rectas, sin brillo. */
			.wa-float {
				position: fixed;
				right: 1rem;
				bottom: 1rem;
				z-index: 90;
				display: grid;
				place-items: center;
				width: 50px;
				height: 50px;
				border-radius: var(--radius-lg);
				background: var(--primary);
				color: var(--primary-foreground);
				border: 1px solid var(--border-strong);
				transition: transform var(--d2) var(--nx-ease-out), background-color var(--d2) var(--ease);
			}
			.wa-float:hover {
				color: var(--primary-foreground);
				transform: translateY(-2px);
			}
			@media (min-width: 900px) {
				.wa-float { right: 1.5rem; bottom: 1.5rem; width: 54px; height: 54px; }
			}
		</style>
	</body>
</html>
