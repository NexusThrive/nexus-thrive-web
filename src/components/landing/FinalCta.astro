---
import Logo from '../brand/Logo.astro';
import { APP_URL, whatsappLink } from '../../data/site';
---

<section class="final" id="contacto" aria-labelledby="final-title">
	<div class="container final-inner">
		<div class="final-copy" data-reveal>
			<h2 id="final-title" class="title-lg final-title">
				Tu negocio ya tiene una visión. <span class="mark">Construyamos el sistema</span> que necesita.
			</h2>
			<p class="lead final-lead">Cuéntanos cómo opera hoy tu negocio. Empezamos por entender el problema.</p>
			<div class="final-actions">
				<a href={whatsappLink('Hola NEXUS THRIVE, quiero conocer NEXUS para mi negocio.')} class="btn btn--accent" target="_blank" rel="noopener" data-cta="whatsapp-cierre">
					Conocer NEXUS por WhatsApp
					<svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
				</a>
				<a href={APP_URL} class="btn btn--ghost-inverse" data-cta="app-cierre">Entrar a la plataforma</a>
			</div>
		</div>
		<div class="final-mark" aria-hidden="true">
			<Logo variant="mark" size={320} title="" />
		</div>
	</div>
</section>

<style>
	.final {
		background: var(--nx-ink);
		color: var(--nx-paper);
		padding-block: clamp(5rem, 11vw, 9rem);
		overflow: hidden;
	}

	.final-inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 3rem;
		align-items: center;
	}

	.final-copy {
		display: grid;
		gap: 1.5rem;
		max-width: 820px;
	}

	.final-title {
		color: var(--nx-paper);
	}

	.final-lead {
		color: var(--nx-graphite-400);
	}

	.final-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 0.6rem;
	}

	.btn--ghost-inverse {
		border-color: var(--nx-graphite-700);
		color: var(--nx-paper);
	}

	.btn--ghost-inverse:hover {
		border-color: var(--nx-paper);
		color: var(--nx-paper);
	}

	.final-mark {
		color: var(--nx-graphite-800);
		width: clamp(160px, 24vw, 320px);
	}

	.final-mark :global(svg) {
		width: 100%;
		height: auto;
	}

	@media (max-width: 799px) {
		.final-inner {
			grid-template-columns: 1fr;
		}

		.final-mark {
			display: none;
		}

		.final-actions .btn {
			flex: 1 1 100%;
			white-space: normal;
		}
	}
</style>
