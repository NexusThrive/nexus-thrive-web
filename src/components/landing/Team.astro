---
import { TEAM } from '../../data/site';
---

<section class="section team" id="equipo" aria-labelledby="team-title">
	<div class="container">
		<header class="team-head" data-reveal>
			<p class="eyebrow">El equipo de NEXUS THRIVE</p>
			<h2 id="team-title" class="title-lg">Las personas que construyen NEXUS.</h2>
			<p class="lead">Un equipo pequeño que trabaja directo con cada negocio, de la primera conversación al sistema en uso.</p>
		</header>

		<ul class="team-list" role="list">
			{TEAM.map((p, i) => (
				<li data-reveal style={`--reveal-delay:${i * 70}ms`}>
					<span class="team-avatar" aria-hidden="true">{p.initials}</span>
					<div class="team-body">
						<p class="team-area">{p.area}</p>
						<h3>{p.name}</h3>
						<p class="team-text">{p.text}</p>
					</div>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.team {
		background: var(--surface);
		border-block: 1px solid var(--border);
	}

	.team-head {
		display: grid;
		gap: 1.2rem;
		max-width: 760px;
	}

	.team-list {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		margin-top: clamp(2.5rem, 5vw, 4rem);
		list-style: none;
		border-top: 1px solid var(--border);
	}

	.team-list li {
		display: grid;
		gap: 1.4rem;
		align-content: start;
		padding: 2rem 1.5rem 2rem 0;
	}

	.team-list li + li {
		padding-left: 1.5rem;
		border-left: 1px solid var(--border);
	}

	/* Sin fotos publicadas: bloque Ink con iniciales, como el logo. */
	.team-avatar {
		display: grid;
		place-items: center;
		width: 72px;
		height: 72px;
		border-radius: var(--radius-lg);
		background: var(--surface-inverse);
		color: var(--nx-paper);
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		clip-path: polygon(0 0, 100% 0, 100% 78%, 78% 100%, 0 100%);
	}

	[data-theme='dark'] .team-avatar {
		background: var(--nx-paper);
		color: var(--nx-ink);
	}

	.team-area {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--accent-text);
	}

	.team-list h3 {
		margin-top: 0.35rem;
		font-family: var(--font-display);
		font-size: 1.2rem;
		font-weight: 700;
		letter-spacing: -0.015em;
		line-height: 1.2;
	}

	.team-text {
		margin-top: 0.6rem;
		font-size: 0.94rem;
		color: var(--foreground-muted);
	}

	@media (max-width: 999px) {
		.team-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.team-list li,
		.team-list li + li {
			padding: 1.75rem 1.25rem 1.75rem 0;
			border-left: 0;
			border-bottom: 1px solid var(--border);
		}

		.team-list li:nth-child(even) {
			padding-left: 1.25rem;
			border-left: 1px solid var(--border);
		}
	}

	@media (max-width: 519px) {
		.team-list {
			grid-template-columns: 1fr;
		}

		.team-list li,
		.team-list li:nth-child(even) {
			grid-template-columns: 64px 1fr;
			padding: 1.5rem 0;
			border-left: 0;
		}

		.team-avatar {
			width: 64px;
			height: 64px;
			font-size: 1.15rem;
		}
	}
</style>
