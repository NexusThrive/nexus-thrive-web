---
/**
 * Fundadores de NEXUS. Cuando llegue la foto del CEO, importarla desde
 * `../../assets/<archivo>` y asignarla en `photos` con el nombre exacto; el
 * avatar la recorta al mismo formato que el monograma.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { FOUNDERS } from '../../data/site';
import  CeoPhoto  from '../../../public/CEO.JPG'

const photos: Record<string, ImageMetadata> = {
	'Santiago Castellar': CeoPhoto,
};
---

<section class="section team" id="equipo" aria-labelledby="team-title">
	<div class="container">
		<header class="team-head" data-reveal>
			<p class="eyebrow">Los fundadores</p>
			<h2 id="team-title" class="title-lg">Las personas que construyen NEXUS.</h2>
			<p class="lead">NEXUS lo construyen Santiago y Nicolas, sus fundadores: dos personas que trabajan directo con cada negocio, de la primera conversación al sistema en uso.</p>
		</header>

		<ul class="team-list" role="list">
			{FOUNDERS.map((p, i) => {
				const photo = photos[p.name];
				return (
					<li data-reveal style={`--reveal-delay:${i * 90}ms`}>
						<span class="team-avatar" aria-hidden="true">
							{photo ? <Image src={photo} alt="" widths={[112, 224]} sizes="112px" /> : p.initials}
						</span>
						<div class="team-body">
							<p class="team-area">Fundador · {p.role}</p>
							<h3>{p.name}</h3>
							<p class="team-text">{p.text}</p>
						</div>
					</li>
				);
			})}
		</ul>
	</div>
</section>

<style>
	.team {
		background: var(--surface);
		border-block: 1px solid var(--border);
	}

	.team-head {
		display: grid;
		gap: 1.2rem;
		max-width: 760px;
	}

	.team-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(1rem, 2vw, 1.5rem);
		margin-top: clamp(2.5rem, 5vw, 4rem);
		list-style: none;
	}

	.team-list li {
		display: grid;
		gap: 1.6rem;
		align-content: start;
		padding: clamp(1.75rem, 3vw, 2.5rem);
		background: var(--background);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
	}

	/* Sin fotos publicadas: bloque Ink con iniciales, como el logo. */
	.team-avatar {
		display: grid;
		place-items: center;
		overflow: hidden;
		width: 212px;
		height: 212px;
		border-radius: var(--radius-lg);
		background: var(--surface-inverse);
		color: var(--nx-paper);
		font-family: var(--font-display);
		font-size: 2rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		clip-path: polygon(0 0, 100% 0, 100% 78%, 78% 100%, 0 100%);
	}

	.team-avatar img {
		width: 90%;
    height: 90%;
    border-radius: 10px;
    object-fit: cover;
	}

	[data-theme='dark'] .team-avatar {
		background: var(--nx-paper);
		color: var(--nx-ink);
	}

	.team-area {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--accent-text);
	}

	.team-list h3 {
		margin-top: 0.5rem;
		font-family: var(--font-display);
		font-size: clamp(1.4rem, 2.2vw, 1.75rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.15;
	}

	.team-text {
		margin-top: 0.75rem;
		max-width: 44ch;
		font-size: 1rem;
		color: var(--foreground-muted);
	}

	@media (max-width: 767px) {
		.team-list {
			grid-template-columns: 1fr;
		}

		.team-list li {
			grid-template-columns: 88px 1fr;
			align-items: start;
			gap: 1.25rem;
			padding: 1.5rem;
		}

		.team-avatar {
			width: 88px;
			height: 88px;
			font-size: 1.6rem;
		}
	}
</style>
