---
import SectionBackground from '../react/SectionBackground';
import { FAQ, FAQ_SECTION, CTA } from '../../data/landing';
import { stripTodos, withTodos } from '../../lib/todo';

// Los marcadores pendientes no van a los datos estructurados.
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: FAQ.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: stripTodos(f.a) },
	})),
};
---

<section class="full faq" id="faq" aria-labelledby="faq-title">
	<div class="full-bg" aria-hidden="true"><SectionBackground client:load kind="ondas" /></div>
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	<div class="container faq-grid">
		<header class="faq-head" data-head>
			<h2 id="faq-title" class="title-lg">{FAQ_SECTION.title}</h2>

			<div class="faq-ask glass-lg">
				<span class="faq-ball" aria-hidden="true"><i></i><i></i></span>
				<div>
					<b>¿Tu pregunta no está aquí?</b>
					<p>Cuéntanos tu caso y te respondemos con calma.</p>
				</div>
				<a href="#diagnostico" class="btn btn--primary" data-cta="faq-diagnostico">{CTA.primary}</a>
			</div>
		</header>

		<div class="faq-list">
			{FAQ.map((f, i) => (
				<details class="glass-lg" name="faq" open={i === 0} data-reveal data-spot>
					<summary>
						<span class="faq-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
						<span class="faq-q">{f.q}</span>
						<svg class="chev" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
					</summary>
					<div class="answer"><p set:html={withTodos(f.a)} /></div>
				</details>
			))}
		</div>
	</div>
</section>

<script>
	// Brillo que sigue al cursor dentro de cada pregunta (muy suave).
	document.querySelectorAll<HTMLElement>('.faq-list [data-spot]').forEach((el) => {
		el.addEventListener('pointermove', (e) => {
			const r = el.getBoundingClientRect();
			el.style.setProperty('--mx', `${e.clientX - r.left}px`);
			el.style.setProperty('--my', `${e.clientY - r.top}px`);
		}, { passive: true });
	});
</script>

<style>
	.faq-grid {
		display: grid;
		grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
		gap: clamp(2rem, 6vw, 5rem);
		align-items: center;
	}

	.faq-head {
		display: grid;
		gap: 1.2rem;
		justify-items: start;
	}

	/* Tarjeta de vidrio con Auri: invita a escribir si la respuesta no está en la lista. */
	.faq-ask {
		position: relative;
		display: grid;
		gap: 0.9rem;
		justify-items: start;
		margin-top: 0.6rem;
		padding: 1.2rem;
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: var(--radius-widget);
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.02) 55%, rgba(255, 255, 255, 0.06)),
			rgba(14, 14, 16, 0.5);
		-webkit-backdrop-filter: blur(18px) saturate(160%);
		backdrop-filter: blur(18px) saturate(160%);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.24), 0 20px 44px -22px rgba(0, 0, 0, 0.8);
	}

	.faq-ask b {
		display: block;
		font-family: var(--font-display);
		font-size: 1.05rem;
		letter-spacing: -0.02em;
	}

	.faq-ask p {
		margin-top: 0.2rem;
		font-size: 0.9rem;
		color: var(--foreground-muted);
	}

	.faq-ball {
		position: relative;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--nx-ink);
		border: 1px solid rgba(212, 175, 55, 0.55);
		box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.12), 0 0 22px rgba(212, 175, 55, 0.3);
		animation: faq-float 4.5s ease-in-out infinite;
	}

	.faq-ball i {
		position: absolute;
		top: 41%;
		width: 10.8%;
		height: 18%;
		border-radius: 999px;
		background: var(--nx-gold-300);
		animation: faq-blink 4.2s infinite;
	}

	.faq-ball i:first-child { left: 35.1%; }
	.faq-ball i:last-child { left: 54.1%; }

	@keyframes faq-float {
		50% { transform: translateY(-6px); }
	}

	@keyframes faq-blink {
		0%, 92%, 100% { transform: scaleY(1); }
		96% { transform: scaleY(0.12); }
	}

	.faq-list {
		display: grid;
		gap: 0.5rem;
	}

	details {
		position: relative;
		isolation: isolate;
		padding-inline: clamp(1rem, 2.4vw, 1.5rem);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--surface);
		box-shadow: var(--nx-shadow-xs);
		overflow: hidden;
		interpolate-size: allow-keywords;
		transition: box-shadow var(--d3) var(--ease), border-color var(--d3) var(--ease), background-color var(--d3) var(--ease);
	}

	/* Brillo dorado que sigue al cursor. */
	details::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: radial-gradient(280px circle at var(--mx, 50%) var(--my, 0%), rgba(212, 175, 55, 0.12), transparent 70%);
		opacity: 0;
		transition: opacity var(--d3) var(--ease);
	}

	details:hover::before,
	details[open]::before {
		opacity: 1;
	}

	details:hover,
	details[open] {
		border-color: var(--border-strong);
		box-shadow: var(--nx-shadow-sm);
	}

	details[open] {
		border-color: rgba(212, 175, 55, 0.5) !important;
	}

	/* La respuesta se abre y se cierra con altura animada (donde el navegador lo permite). */
	details::details-content {
		block-size: 0;
		overflow: clip;
		transition: block-size var(--d3) var(--nx-ease-out), content-visibility var(--d3) allow-discrete;
	}

	details[open]::details-content {
		block-size: auto;
	}

	summary {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: clamp(0.6rem, 1.5vh, 0.95rem) 0;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(0.98rem, 1.4vw, 1.1rem);
		letter-spacing: -0.02em;
		line-height: 1.3;
		cursor: pointer;
		list-style: none;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	.faq-n {
		flex: none;
		font-family: var(--font-mono);
		font-size: 0.74rem;
		font-weight: 500;
		letter-spacing: 0.04em;
		color: var(--foreground-muted);
		transition: color var(--d2) var(--ease);
	}

	.faq-q {
		flex: 1;
	}

	summary:hover .faq-q,
	details[open] .faq-n {
		color: var(--accent-text);
	}

	.chev {
		flex: none;
		box-sizing: content-box;
		padding: 4px;
		border-radius: 50%;
		background: var(--surface-muted);
		transition: transform var(--d3) var(--nx-ease-out), background-color var(--d3) var(--ease);
	}

	details[open] .chev {
		background: var(--accent);
		color: var(--nx-ink);
		transform: rotate(135deg);
	}

	.answer {
		padding: 0 0 1rem 2.6rem;
	}

	.answer p {
		max-width: 64ch;
		color: var(--foreground-muted);
	}

	details[open] .answer {
		animation: faq-in var(--d3) var(--nx-ease-out) both;
	}

	@keyframes faq-in {
		from {
			opacity: 0;
			transform: translateY(-6px);
		}
	}

	@media (max-width: 899px) {
		.faq-grid {
			grid-template-columns: 1fr;
		}

		.answer {
			padding-left: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.faq-ball,
		.faq-ball i {
			animation: none;
		}
	}
</style>
