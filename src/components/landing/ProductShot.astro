---
/**
 * Captura real de la app (claro u oscuro según el tema activo). Las
 * imágenes salen de src/assets/product/<nombre>-light|dark.webp: pantallas
 * de la app NEXUS con datos de demostración ("Gimnasio Demo").
 *
 * Se renderizan las dos variantes y el CSS muestra la del tema; la que está
 * oculta no se descarga si es `lazy`.
 */
import type { ImageMetadata } from 'astro';

interface Props {
	name: string;
	alt: string;
	/** "browser" lleva barra de ventana; "phone" marco de teléfono; "plain" sin marco. */
	frame?: 'browser' | 'phone' | 'plain';
	priority?: boolean;
	sizes?: string;
	url?: string;
	class?: string;
}

const { name, alt, frame = 'browser', priority = false, sizes = '(min-width: 1280px) 1200px, 100vw', url = 'app.nexusthrive.com.co', class: className } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/product/*.webp', { eager: true });
const pick = (theme: 'light' | 'dark') => {
	const f = files[`../../assets/product/${name}-${theme}.webp`];
	if (!f) throw new Error(`Falta la captura ${name}-${theme}.webp`);
	return f.default;
};
const light = pick('light');
const dark = pick('dark');
---

<figure class:list={['shot', `shot--${frame}`, className]}>
	{frame === 'browser' && (
		<div class="shot-bar" aria-hidden="true">
			<span class="shot-dots"><i></i><i></i><i></i></span>
			<span class="shot-url">{url}</span>
		</div>
	)}
	<div class="shot-media">
		<img src={light.src} width={light.width} height={light.height} alt={alt} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding="async" class="shot-img shot-img--light" />
		<img src={dark.src} width={dark.width} height={dark.height} alt={alt} loading="lazy" decoding="async" class="shot-img shot-img--dark" />
	</div>
</figure>

<style>
	.shot {
		position: relative;
		margin: 0;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-xl);
		overflow: hidden;
		box-shadow: var(--shot-shadow);
	}

	.shot--plain {
		border-radius: var(--radius-lg);
	}

	.shot--phone {
		border-radius: 22px;
		border: 6px solid var(--nx-ink);
		box-shadow: var(--shot-shadow);
	}

	[data-theme='dark'] .shot--phone {
		border-color: var(--nx-graphite-700);
	}

	.shot-bar {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		height: 34px;
		padding: 0 0.85rem;
		border-bottom: 1px solid var(--border);
		background: var(--surface-muted);
	}

	.shot-dots {
		display: flex;
		gap: 6px;
	}

	.shot-dots i {
		width: 9px;
		height: 9px;
		border-radius: 2px;
		background: var(--border-strong);
	}

	.shot-url {
		flex: 1;
		max-width: 320px;
		margin-inline: auto;
		padding: 0.18rem 0.6rem;
		border-radius: var(--radius-sm);
		background: var(--surface);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		color: var(--foreground-muted);
		text-align: center;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.shot-media :global(img) {
		width: 100%;
		height: auto;
	}

	.shot-media :global(.shot-img--dark),
	:global([data-theme='dark']) .shot-media :global(.shot-img--light) {
		display: none;
	}

	:global([data-theme='dark']) .shot-media :global(.shot-img--dark) {
		display: block;
	}
</style>
