---
import ProductShot from './ProductShot.astro';
import { APP_URL } from '../../data/site';
---

<section class="hero" aria-labelledby="hero-title">
	<div class="container hero-copy">
		<p class="eyebrow hero-in" style="--d:0ms">Sistema operativo para tu negocio</p>
		<h1 id="hero-title" class="title-xl hero-title">
			<span class="line"><span class="hero-in" style="--d:80ms">Tu negocio.</span></span>
			<span class="line"><span class="hero-in" style="--d:180ms"><span class="mark">Un solo sistema.</span></span></span>
		</h1>
		<p class="lead hero-lead hero-in" style="--d:300ms">
			NEXUS conecta la operación, los clientes y los procesos de tu negocio en un ecosistema digital diseñado para crecer contigo.
		</p>
		<div class="hero-actions hero-in" style="--d:400ms">
			<a href="#producto" class="btn btn--primary">
				Explorar NEXUS
				<svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
			</a>
			<a href="#soluciones" class="btn btn--outline">Ver soluciones</a>
		</div>
		<p class="hero-note hero-in" style="--d:480ms">
			¿Ya usas NEXUS? <a href={APP_URL} data-cta="app-hero">Entra a la plataforma</a>
		</p>
	</div>

	<div class="container hero-stage hero-in" style="--d:520ms" id="producto">
		<div class="stage">
			<span class="stage-cut" aria-hidden="true"></span>
			<ProductShot
				name="inicio"
				priority
				class="stage-main"
				alt="Inicio de un negocio en NEXUS: ingresos, socios activos, gastos, balance y gráfico de ingresos y gastos de la semana."
			/>
			<ProductShot
				name="m-acceso"
				frame="phone"
				class="stage-phone"
				sizes="(min-width: 900px) 240px, 70vw"
				alt="Control de acceso en el teléfono: el socio puede entrar y le quedan 23 días de membresía."
			/>
		</div>
		<p class="stage-caption">
			<span class="status status--live">Capturas reales</span>
			Pantallas de la app NEXUS con datos de demostración.
		</p>
	</div>
</section>

<style>
	.hero {
		position: relative;
		padding-top: clamp(3rem, 9vw, 7rem);
		padding-bottom: clamp(3rem, 7vw, 6rem);
		overflow: hidden;
	}

	.hero-copy {
		display: grid;
		justify-items: center;
		text-align: center;
	}

	.hero-title {
		margin-top: 1.4rem;
	}

	.hero-title .line {
		display: block;
		overflow: hidden;
		padding-bottom: 0.08em;
	}

	.hero-title .line > span {
		display: inline-block;
	}

	.hero-lead {
		margin-top: 1.6rem;
		margin-inline: auto;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 2.2rem;
	}

	.hero-note {
		margin-top: 1.1rem;
		font-size: 0.9rem;
		color: var(--foreground-muted);
	}

	.hero-note a {
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	/* Entrada del hero: el titular sube desde su propia línea (clipping). */
	.js .hero-in {
		animation: hero-rise var(--d4) var(--nx-ease-out) both;
		animation-delay: var(--d, 0ms);
	}

	.js .hero-title .hero-in {
		animation-name: hero-line;
		animation-duration: 820ms;
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
	}

	@keyframes hero-line {
		from {
			transform: translateY(105%);
		}
	}

	/* ---------- Escenario del producto ---------- */

	.hero-stage {
		margin-top: clamp(3rem, 7vw, 5.5rem);
	}

	.stage {
		position: relative;
		padding-right: clamp(0px, 9vw, 120px);
		padding-bottom: clamp(0px, 4vw, 48px);
	}

	/* Motivo de marca: el corte diagonal de la N, uno solo por pantalla. */
	.stage-cut {
		position: absolute;
		z-index: 0;
		top: -10%;
		bottom: 8%;
		left: 58%;
		width: clamp(60px, 9vw, 120px);
		background: var(--accent);
		transform: skewX(var(--nx-angle));
		opacity: 0.9;
	}

	.stage :global(.stage-main) {
		position: relative;
		z-index: 1;
	}

	.stage :global(.stage-phone) {
		position: absolute;
		z-index: 2;
		right: 0;
		bottom: 0;
		width: clamp(150px, 19vw, 250px);
	}

	.stage-caption {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		margin-top: 1.4rem;
		font-size: 0.85rem;
		color: var(--foreground-muted);
	}

	@media (max-width: 699px) {
		.stage {
			padding: 0;
			display: grid;
			justify-items: center;
		}

		/* En móvil la captura de escritorio no se lee: se muestra el teléfono. */
		.stage :global(.stage-main) {
			display: none;
		}

		.stage :global(.stage-phone) {
			position: relative;
			width: min(78vw, 300px);
		}

		.stage-cut {
			left: 50%;
			top: 6%;
			bottom: 6%;
			transform: translateX(-50%) skewX(var(--nx-angle));
		}

		.hero-actions .btn {
			flex: 1 1 100%;
		}
	}
</style>
