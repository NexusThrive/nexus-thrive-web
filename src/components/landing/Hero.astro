---
import HeroBackground from '../react/HeroBackground';
import AuriAsk from '../react/AuriAsk';
import { HERO } from '../../data/landing';
import { ArrowRight } from '@lucide/astro';

const [l1, l2] = HERO.titleLines;
---

<section class="hero" aria-labelledby="hero-title" data-hero>
	<!-- Fondo animado a pantalla completa (React Bits). Por defecto GhostFibers; /?bg=magnet-lines, /?bg=threads, /?bg=aurora, /?bg=antigravity, /?bg=gradient-ascii o /?bg=pixel-blast para probar otro. -->
	<div class="hero-bg" aria-hidden="true">
		<HeroBackground client:only="react" />
		<span class="hero-fade"></span>
	</div>

	<div class="container hero-grid">
		<div class="hero-copy" data-hero-inner>
			<h1 id="hero-title" class="hero-title">
				<span class="line"><span class="hero-in" style="--d:0ms">{l1}</span></span>
				<span class="line"><span class="hero-in" style="--d:80ms"><span class="mark">{HERO.titleMark}</span></span></span>
			</h1>
			<p class="hero-sub hero-in" style="--d:200ms">{HERO.subtitle}</p>

			<div class="hero-actions hero-in" style="--d:300ms">
				<a href="#diagnostico" class="btn btn--primary" data-cta="hero-diagnostico">
					{HERO.primary}
					<ArrowRight class="arrow" size={18} stroke-width={2} aria-hidden="true" />
				</a>
				<a href="#sistema" class="btn btn--outline">{HERO.secondary}</a>
			</div>



		</div>

		<div class="hero-auri hero-in" style="--d:240ms" id="auri">
			<AuriAsk client:load />
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		overflow: clip;
		margin-top: calc(var(--nav-h) * -1);
		/* El hero ocupa toda la pantalla al entrar; el contenido se centra en vertical. */
		min-height: 100vh;
		min-height: 100svh;
		display: grid;
		align-items: center;
		/* Mismo aire arriba y abajo: el conjunto queda en el centro exacto de la ventana. */
		padding-block: var(--nav-h);
	}

	.hero-bg {
		position: absolute;
		inset: 0;
		z-index: -1;
	}

	.hero-bg :global(.ghost-fibers),
	.hero-bg :global(.magnet-lines),
	.hero-bg :global(.threads-container),
	.hero-bg :global(.aurora-container),
	.hero-bg :global(.antigravity),
	.hero-bg :global(.gradient-ascii-container),
	.hero-bg :global(.pixel-blast-container) {
		position: absolute;
		inset: 0;
	}

	/* El fondo se funde con el papel de la página al terminar el hero. */
	.hero-fade {
		position: absolute;
		inset: auto 0 0 0;
		height: 45%;
		background: linear-gradient(to bottom, transparent, var(--background));
	}

	.hero-grid {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(0, 1.16fr) minmax(0, 0.84fr);
		gap: clamp(1.5rem, 3vw, 3rem);
		max-width: calc(1440px + var(--gutter) * 2);
		align-items: center;
	}

	.hero-copy {
		position: relative;
		display: grid;
		justify-items: start;
		gap: 0;
	}

	/* Viñeta oscura detrás del texto: los puntos del fondo no le restan legibilidad. */
	.hero-copy::before {
		content: '';
		position: absolute;
		inset: -3rem -3rem -3rem -4rem;
		z-index: -1;
		background: radial-gradient(ellipse closest-side, color-mix(in srgb, var(--background) 88%, transparent) 40%, transparent 100%);
		pointer-events: none;
	}

	.hero-title {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(2.1rem, 3.65vw, 4.1rem);
		letter-spacing: -0.045em;
		line-height: 1.04;
		text-wrap: balance;
		color: var(--foreground);
	}

	.hero-title .line {
		display: block;
		overflow: hidden;
		padding-bottom: 0.12em;
		margin-bottom: -0.12em;
	}

	.hero-title .line > span {
		display: inline-block;
	}

	.hero-note {
		margin-top: 1.4rem;
		max-width: 46ch;
		font-size: 0.85rem;
		color: var(--foreground-muted);
	}

	.hero-sub {
		margin-top: 1.4rem;
		max-width: 52ch;
		font-size: clamp(1.05rem, 1.45vw, 1.35rem);
		line-height: 1.6;
		color: var(--foreground-muted);
		text-wrap: pretty;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.8rem;
	}

	/* El centro de la caja es donde se queda Auri (esfera y respuesta): coincide con el centro
	   de la pantalla. La píldora nace por debajo y vuela hasta ahí. */
	.hero-auri {
		--mo-h: 400px;
		display: grid;
	}

	/* Auri más grande. `zoom` (y no `scale`) para que el texto y los bordes sigan nítidos. */
	@media (min-width: 960px) {
		.hero-auri {
			zoom: 1.2;
		}
	}

	@media (min-width: 1280px) and (min-height: 720px) {
		.hero-auri {
			zoom: 1.45;
		}
	}

	@media (min-width: 1700px) and (min-height: 900px) {
		.hero-auri {
			zoom: 1.7;
		}
	}

	/* Entrada del hero: el titular sube desde su línea; el resto se desliza. */
	.js .hero-in {
		animation: hero-rise 500ms var(--nx-ease-out) both;
		animation-delay: calc(var(--d, 0ms) * 0.55);
	}

	.js .hero-title .hero-in {
		animation-name: hero-line;
		animation-duration: 700ms;
	}

	/* Mientras corre la pantalla de carga, la entrada espera. */
	:global(html.preloading.js) .hero-in {
		animation-play-state: paused;
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
	}

	@keyframes hero-line {
		from {
			transform: translateY(105%);
		}
	}

	@media (max-width: 959px) {
		.hero {
			padding-block: calc(var(--nav-h) + 1.5rem) 2rem;
		}

		.hero-auri {
			--mo-h: 380px;
			translate: none;
		}

		.hero-grid {
			grid-template-columns: 1fr;
		}

		.hero-copy {
			justify-items: center;
			text-align: center;
		}

		.hero-actions {
			justify-content: center;
		}
	}

	@media (max-width: 599px) {
		.hero-actions .btn {
			flex: 1 1 100%;
		}
	}
</style>
