---
import Logo from '../brand/Logo.astro';
import { APP_URL, NAV } from '../../data/site';
import { CTA } from '../../data/landing';

---

<header class="nav" data-nav>
	<div class="nav-wrap container">
	<div class="nav-inner glass">
		<a href="/" class="nav-logo" aria-label="NEXUS THRIVE, inicio">
			<Logo variant="mark" size={34} title="NEXUS THRIVE" />
		</a>

		<nav class="nav-links" aria-label="Principal">
			<ul role="list">
				{NAV.map((item) => (
					<li><a href={item.href}>{item.label}</a></li>
				))}
			</ul>
		</nav>

		<div class="nav-actions">
			<a href="/#diagnostico" class="btn btn--accent btn--sm nav-cta" data-cta="nav-diagnostico">{CTA.primary}</a>
			<button type="button" class="nav-burger" data-menu-toggle aria-expanded="false" aria-controls="menu-movil" aria-label="Abrir menú">
				<span></span><span></span>
			</button>
		</div>
	</div>
	</div>

	<div class="nav-sheet" id="menu-movil" data-menu hidden>
		<nav aria-label="Principal (móvil)" class="container">
			<ul role="list">
				{NAV.map((item, i) => (
					<li style={`--i:${i}`}><a href={item.href} data-menu-link>{item.label}</a></li>
				))}
			</ul>
			<div class="nav-sheet-actions">
				<a href="/#diagnostico" class="btn btn--accent" data-menu-link data-cta="menu-diagnostico">{CTA.primary}</a>
			</div>
		</nav>
	</div>
</header>

<script>
	const root = document.documentElement;
	const nav = document.querySelector<HTMLElement>('[data-nav]')!;

	// Estado de scroll: la barra gana fondo y borde al bajar.
	const onScroll = () => nav.classList.toggle('is-scrolled', window.scrollY > 8);
	onScroll();
	window.addEventListener('scroll', onScroll, { passive: true });


	// La barra se esconde al bajar y vuelve al subir; dentro de la escena del sistema no aparece nunca.
	let lastY = window.scrollY;
	let inScene = false;
	let goingDown = false;
	const syncBar = () => nav.classList.toggle('is-hidden', inScene || (goingDown && window.scrollY > window.innerHeight * 0.5));
	window.addEventListener('scroll', () => {
		const y = window.scrollY;
		if (Math.abs(y - lastY) < 6) return;
		goingDown = y > lastY;
		lastY = y;
		syncBar();
	}, { passive: true });
	const scene = document.querySelector('[data-scene]');
	if (scene) {
		new IntersectionObserver(([e]) => { inScene = e.isIntersecting; syncBar(); }, { rootMargin: '0px 0px -88% 0px' }).observe(scene);
	}

	// Menú móvil accesible: Escape lo cierra y el foco vuelve al botón.
	const burger = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
	const sheet = document.querySelector<HTMLElement>('[data-menu]')!;
	const setOpen = (open: boolean) => {
		burger.setAttribute('aria-expanded', String(open));
		burger.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
		nav.classList.toggle('is-open', open);
		if (open) {
			sheet.hidden = false;
			requestAnimationFrame(() => sheet.classList.add('is-visible'));
			sheet.querySelector<HTMLElement>('a')?.focus();
		} else {
			sheet.classList.remove('is-visible');
			window.setTimeout(() => (sheet.hidden = true), 220);
		}
	};
	burger.addEventListener('click', () => setOpen(burger.getAttribute('aria-expanded') !== 'true'));
	sheet.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
			setOpen(false);
			burger.focus();
		}
	});
	window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>

<style>
	/* Barra flotante de vidrio: una píldora que no ocupa el ancho entero. */
	.nav {
		position: sticky;
		top: 0;
		z-index: 80;
		height: var(--nav-h);
		padding-top: 24px;
		pointer-events: none;
	}

	.nav-wrap {
		height: 100%;
		max-width: calc(1440px + var(--gutter) * 2);
	}

	/* Vidrio líquido oscuro: tinte negro translúcido, desenfoque, borde de luz y un reflejo especular
	   que resbala por arriba. El fondo del hero se asoma por detrás. */
	.nav-inner {
		position: relative;
		isolation: isolate;
		display: flex;
		align-items: center;
		gap: 1.25rem;
		height: 56px;
		padding: 0 0.6rem 0 1.2rem;
		border-radius: 999px;
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.09) 0%, rgba(255, 255, 255, 0.02) 45%, rgba(255, 255, 255, 0.06) 100%),
			color-mix(in srgb, var(--background) 72%, transparent);
		border: 1px solid rgba(255, 255, 255, 0.14);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.28),
			inset 0 -1px 0 rgba(255, 255, 255, 0.05),
			inset 0 0 22px rgba(255, 255, 255, 0.04),
			0 12px 32px -14px rgba(0, 0, 0, 0.7);
		pointer-events: auto;
		transition: box-shadow var(--d3) var(--ease), background-color var(--d3) var(--ease);
	}

	/* Reflejo especular de la esquina izquierda, detrás del contenido. */
	.nav-inner::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: inherit;
		background: radial-gradient(60% 140% at 4% 0%, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0) 60%);
		pointer-events: none;
	}

	/* Al bajar, el vidrio gana un poco de cuerpo para que el texto de abajo no interfiera. */
	.nav.is-scrolled .nav-inner,
	.nav.is-open .nav-inner {
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.09) 0%, rgba(255, 255, 255, 0.02) 45%, rgba(255, 255, 255, 0.06) 100%),
			color-mix(in srgb, var(--background) 88%, transparent);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.28),
			inset 0 -1px 0 rgba(255, 255, 255, 0.05),
			inset 0 0 22px rgba(255, 255, 255, 0.04),
			0 16px 38px -14px rgba(0, 0, 0, 0.8);
	}

	.nav-wrap {
		transition: transform var(--d3) var(--nx-ease-out), opacity var(--d2) var(--ease), visibility var(--d3);
	}

	/* Con el teclado dentro o el menú abierto nunca se esconde: el foco no puede quedar invisible. */
	.nav.is-hidden:not(.is-open, :has(:focus-visible)) .nav-wrap {
		transform: translateY(-110px);
		opacity: 0;
	}

	.nav.is-hidden:not(.is-open, :has(:focus-visible)) .nav-inner {
		pointer-events: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.nav-wrap {
			transition: none;
		}
	}

	/* Solo la N del logo oficial (variante mark). */
	.nav-logo {
		display: inline-flex;
		align-items: center;
		color: var(--foreground);
	}

	.nav-logo:hover {
		color: var(--foreground);
	}

	.nav-links {
		margin-left: auto;
	}

	/* En escritorio, los enlaces quedan centrados en la píldora: logo | enlaces | acción. */
	@media (min-width: 900px) {
		.nav-inner {
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
			padding-inline: 0.6rem;
		}

		.nav-logo {
			padding-left: 0.6rem;
		}

		.nav-links {
			margin-left: 0;
			justify-self: center;
		}

		.nav-actions {
			justify-self: end;
		}
	}

	.nav-links ul {
		display: flex;
		gap: 0.25rem;
		list-style: none;
	}

	.nav-links a {
		display: block;
		padding: 0.5rem 0.9rem;
		border-radius: 999px;
		font-size: 0.92rem;
		font-weight: 500;
		color: var(--foreground-muted);
		border: 1px solid transparent;
		transition: background-color var(--d2) var(--ease), color var(--d2) var(--ease), border-color var(--d2) var(--ease), box-shadow var(--d2) var(--ease);
	}

	/* Al pasar el cursor, el enlace se vuelve una cápsula de vidrio oscuro con borde de luz. */
	.nav-links a:hover,
	.nav-links a:focus-visible {
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04));
		border-color: rgba(255, 255, 255, 0.14);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 4px 14px -6px rgba(0, 0, 0, 0.6);
		color: var(--foreground);
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.nav-burger {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 50%;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04));
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3);
		color: var(--foreground);
		cursor: pointer;
		transition: background-color var(--d2) var(--ease), box-shadow var(--d2) var(--ease);
	}

	.nav-burger:hover {
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.08));
	}

	.nav-login {
		padding: 0.5rem 0.75rem;
		font-size: 0.92rem;
		font-weight: 600;
		color: var(--foreground);
	}

	.nav-login:hover {
		color: var(--accent-text);
	}

	.nav-burger {
		display: none;
		align-content: center;
		gap: 6px;
	}

	.nav-burger span {
		display: block;
		width: 18px;
		height: 2px;
		background: currentColor;
		transition: transform var(--d2) var(--nx-ease-out);
	}

	.nav.is-open .nav-burger span:first-child {
		transform: translateY(4px) rotate(45deg);
	}

	.nav.is-open .nav-burger span:last-child {
		transform: translateY(-4px) rotate(-45deg);
	}

	.nav-sheet {
		position: absolute;
		inset: var(--nav-h) 0 auto;
		height: calc(100dvh - var(--nav-h));
		background: var(--background);
		border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
		border-top: 1px solid var(--border);
		pointer-events: auto;
		opacity: 0;
		transform: translateY(-8px);
		transition: opacity var(--d2) var(--ease), transform var(--d3) var(--nx-ease-out);
		overflow-y: auto;
	}

	.nav-sheet.is-visible {
		opacity: 1;
		transform: none;
	}

	.nav-sheet ul {
		list-style: none;
		padding-block: 1.25rem;
	}

	.nav-sheet li a {
		display: block;
		padding: 0.9rem 0;
		border-bottom: 1px solid var(--border);
		font-family: var(--font-display);
		font-size: 1.6rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--foreground);
	}

	.nav-sheet.is-visible li {
		animation: sheet-in var(--d3) var(--nx-ease-out) both;
		animation-delay: calc(var(--i) * 40ms);
	}

	@keyframes sheet-in {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
	}

	.nav-sheet-actions {
		display: grid;
		gap: 0.6rem;
		padding-bottom: 2rem;
	}

	@media (max-width: 899px) {
		.nav-links,
		.nav-login,
		.nav-cta {
			display: none;
		}

		.nav-actions {
			margin-left: auto;
		}

		.nav-burger {
			display: grid;
		}
	}

</style>
