---
import { PRINCIPLES } from '../../data/site';
---

<section class="section princ" aria-labelledby="princ-title">
	<div class="container princ-grid">
		<header data-reveal class="princ-head">
			<p class="eyebrow">Visión y principios</p>
			<h2 id="princ-title" class="title-lg">Ambición de plataforma, trato de equipo pequeño.</h2>
			<p class="lead">
				Queremos que cada negocio tenga un sistema a su medida. Lo construimos paso a paso, con versiones pequeñas y sin prometer lo que todavía no existe.
			</p>
		</header>

		<dl class="princ-list">
			{PRINCIPLES.map((p, i) => (
				<div data-reveal style={`--reveal-delay:${i * 50}ms`}>
					<dt>{p.title}</dt>
					<dd>{p.text}</dd>
				</div>
			))}
		</dl>
	</div>
</section>

<style>
	.princ-grid {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		gap: clamp(2.5rem, 6vw, 6rem);
	}

	.princ-head {
		display: grid;
		gap: 1.3rem;
		align-content: start;
	}

	.princ-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0 clamp(1.5rem, 3vw, 2.5rem);
	}

	.princ-list div {
		padding: 1.4rem 0;
		border-top: 1px solid var(--border);
	}

	.princ-list dt {
		font-family: var(--font-display);
		font-size: 1.15rem;
		font-weight: 700;
		letter-spacing: -0.015em;
	}

	.princ-list dt::before {
		content: '/';
		margin-right: 0.45rem;
		color: var(--accent-text);
	}

	.princ-list dd {
		margin-top: 0.35rem;
		font-size: 0.95rem;
		color: var(--foreground-muted);
	}

	@media (max-width: 899px) {
		.princ-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 519px) {
		.princ-list {
			grid-template-columns: 1fr;
		}
	}
</style>
