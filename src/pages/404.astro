---
/**
 * 404 de NEXUS: la misma de la app (nexus-thrive/app/not-found.tsx).
 * El CSS es copia exacta de nexus-thrive/packages/brand/css/not-found.css;
 * `pnpm check:brand` falla si se separan.
 */
import Layout from '../layouts/Layout.astro';
import '../styles/not-found.css';

const N_PATH =
  'M394.83 874.18 L394.83 239.93 L699.27 239.93 L837.22 525.34 L864.18 511.07 L799.96 371.52 L799.96 239.93 L1129.79 239.93 L1129.79 874.18 L815.82 874.18 L704.04 614.93 L677.87 630.79 L725.44 741.77 L725.44 874.18 Z';
---

<Layout title="Página no encontrada">
  <main class="nf" aria-labelledby="nf-title">
    <div class="nf-grid" aria-hidden="true"></div>
    <div class="nf-beam" aria-hidden="true"></div>
    <section class="nf-card">
      <p class="nf-eyebrow">
        <span class="nf-dot" aria-hidden="true"></span>
        Error 404 · Ruta no encontrada
      </p>
      <div class="nf-code" role="img" aria-label="404">
        <span class="nf-digit" aria-hidden="true">4</span>
        <svg class="nf-n" viewBox="380 225 765 665" aria-hidden="true">
          <path class="o" d={N_PATH} pathLength="1"></path>
          <path class="f" d={N_PATH}></path>
          <path class="t" d={N_PATH} pathLength="1"></path>
        </svg>
        <span class="nf-digit" aria-hidden="true">4</span>
      </div>
      <h1 id="nf-title" class="nf-title">Esta ruta no está en el sistema.</h1>
      <p class="nf-text">
        La página que buscas no existe o cambió de lugar. Todo lo demás sigue funcionando.
      </p>
      <div class="nf-actions">
        <a href="/" class="nf-btn nf-btn--primary">
          Volver al inicio
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"></path>
            <path d="m13 6 6 6-6 6"></path>
          </svg>
        </a>
        <button type="button" class="nf-btn nf-btn--ghost" data-nf-back>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5"></path>
            <path d="m11 18-6-6 6-6"></path>
          </svg>
          Página anterior
        </button>
      </div>
      <p class="nf-trace">
        <span>GET</span>
        <span class="nf-trace-path" data-nf-path>/</span>
        <span class="nf-trace-code">404</span>
      </p>
    </section>
  </main>
</Layout>

<script>
  // La ruta pedida (la 404 es estática) y "Página anterior" (sin historial, al inicio).
  const path = document.querySelector<HTMLElement>('[data-nf-path]');
  if (path) path.textContent = decodeURI(location.pathname) || '/';
  document.querySelector('[data-nf-back]')?.addEventListener('click', () => {
    if (history.length > 1) history.back();
    else location.href = '/';
  });
</script>
