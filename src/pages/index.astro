---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/landing/Nav.astro';
import Hero from '../components/landing/Hero.astro';
import Problem from '../components/landing/Problem.astro';
import SystemScene from '../components/landing/SystemScene.astro';
import Capabilities from '../components/landing/Capabilities.astro';
import Proof from '../components/landing/Proof.astro';
import Process from '../components/landing/Process.astro';
import Differentials from '../components/landing/Differentials.astro';
import Faq from '../components/landing/Faq.astro';
import DiagnosisForm from '../components/landing/DiagnosisForm.astro';
import Divider from '../components/landing/Divider.astro';
import SiteFooter from '../components/landing/SiteFooter.astro';
---

<Layout title="Inicio">
  <Nav />
  <main id="contenido">
    <Hero />
    <Problem />
    <SystemScene />
    <Capabilities />
    <Proof />
    <Process />
    <Differentials />
    <Faq />
    <DiagnosisForm />
    <Divider />
  </main>
  <SiteFooter />
</Layout>
