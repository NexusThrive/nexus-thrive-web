---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/landing/Nav.astro';
import Hero from '../components/landing/Hero.astro';
import WhatIs from '../components/landing/WhatIs.astro';
import Modules from '../components/landing/Modules.astro';
import GymCase from '../components/landing/GymCase.astro';
import Method from '../components/landing/Method.astro';
import Audiences from '../components/landing/Audiences.astro';
import Team from '../components/landing/Team.astro';
import Principles from '../components/landing/Principles.astro';
import FinalCta from '../components/landing/FinalCta.astro';
import SiteFooter from '../components/landing/SiteFooter.astro';
---

<Layout title="Inicio">
  <Nav />
  <main id="contenido">
    <Hero />
    <WhatIs />
    <Modules />
    <GymCase />
    <Method />
    <Audiences />
    <Team />
    <Principles />
    <FinalCta />
